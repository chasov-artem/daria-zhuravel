{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "pulsebeauty-studio.com" }
      ],
      "destination": "https://www.pulsebeauty-studio.com/en",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "pulsebeauty-studio.com" }
      ],
      "destination": "https://www.pulsebeauty-studio.com/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "www.pulsebeauty-studio.com" }
      ],
      "destination": "/en",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
